{
    "ubuntu_deb": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
        "features": {
            "nvc": {
                "installMethod": "deb"
            }
        }
    },
    "debian_source": {
        "image": "mcr.microsoft.com/devcontainers/base:debian",
        "features": {
            "nvc": {
                "installMethod": "source"
            }
        }
    },
    "with_osvvm": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
        "features": {
            "nvc": {
                "libraries": "osvvm"
            }
        }
    }
}
